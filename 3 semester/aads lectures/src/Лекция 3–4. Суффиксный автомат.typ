#import sys.inputs.preamble: *
#import "@preview/cetz:0.3.4"

#let slink = math.op("link")
#let slongest = math.op("longest")
#let slen = math.op("len")
#let sto = math.op("to")

// Заливка выделенных полосок: accent-light есть не во всех преамбулах.
#let hl = accent.lighten(80%)

// Автомат: nodes — имя → ((x, y), подпись над вершиной или none);
// edges — (откуда, куда, буква, изгиб); links — (откуда, куда, изгиб), рисуются пунктиром.
// note-below — вершины, у которых подпись рисуется снизу.
// Изгиб 0 — прямое ребро, иначе — дуга, выгнутая влево (> 0) или вправо (< 0) по ходу ребра.
#let automaton(nodes, edges, links: (), terminal: (), note-below: ()) = align(center)[
  #cetz.canvas(length: 0.85cm, {
    import cetz.draw: *

    let r = 0.34
    let on-circle(p, q) = {
      let (dx, dy) = (q.at(0) - p.at(0), q.at(1) - p.at(1))
      let d = calc.sqrt(dx * dx + dy * dy)
      (p.at(0) + r * dx / d, p.at(1) + r * dy / d)
    }
    let arc(a, b, bend, stroke, fill, label) = {
      let pa = nodes.at(a).at(0)
      let pb = nodes.at(b).at(0)
      let (dx, dy) = (pb.at(0) - pa.at(0), pb.at(1) - pa.at(1))
      let d = calc.sqrt(dx * dx + dy * dy)
      let (nx, ny) = (-dy / d, dx / d)
      let ctrl = ((pa.at(0) + pb.at(0)) / 2 + nx * bend, (pa.at(1) + pb.at(1)) / 2 + ny * bend)
      if bend == 0 {
        line(on-circle(pa, pb), on-circle(pb, pa), stroke: stroke, mark: (end: ">", scale: 0.6, fill: fill))
      } else {
        bezier(on-circle(pa, ctrl), on-circle(pb, ctrl), ctrl, stroke: stroke, mark: (end: ">", scale: 0.6, fill: fill))
      }
      if label != none {
        let side = if bend < 0 { -1 } else { 1 }
        let shift = bend / 2 + side * 0.28
        content(((pa.at(0) + pb.at(0)) / 2 + nx * shift, (pa.at(1) + pb.at(1)) / 2 + ny * shift), label)
      }
    }

    for (name, value) in nodes {
      let (p, note) = value
      circle(p, radius: r, stroke: 0.7pt + ink)
      if name in terminal {
        circle(p, radius: r - 0.07, stroke: 0.7pt + ink)
      }
      content(p, text(size: 9pt)[#name])
      if note != none {
        let dy = if name in note-below { -r - 0.3 } else { r + 0.3 }
        content((p.at(0), p.at(1) + dy), text(size: 7.5pt, fill: muted)[#note])
      }
    }
    for (a, b, c, bend) in edges {
      arc(a, b, bend, 0.7pt + ink, ink, text(size: 9pt, style: "italic")[#c])
    }
    for (a, b, bend) in links {
      arc(a, b, bend, (paint: accent, thickness: 0.7pt, dash: "dashed"), accent, none)
    }
  })
]

// Строки как полоски: items — (x0, x1, y, подпись, заливка или none);
// marks — вертикальные пунктиры (x, y0, y1); notes — свободные подписи ((x, y), текст).
#let bars(items, marks: (), notes: ()) = align(center)[
  #cetz.canvas(length: 0.6cm, {
    import cetz.draw: *
    for (x0, x1, y, label, fill) in items {
      rect((x0, y), (x1, y + 0.6), stroke: 0.7pt + ink, fill: fill)
      content(((x0 + x1) / 2, y + 0.3), text(size: 8.5pt)[#label])
    }
    for (x, y0, y1) in marks {
      line((x, y0), (x, y1), stroke: (paint: accent, thickness: 0.7pt, dash: "dashed"))
    }
    for (p, body) in notes {
      content(p, text(size: 8.5pt)[#body], anchor: "west")
    }
  })
]

// Суффиксный путь до и после шага 5 (для оценки времени работы).
// Сверху — старый путь из last, снизу — новый путь из cur.
#let path-picture = align(center)[
  #cetz.canvas(length: 0.85cm, {
    import cetz.draw: *

    let r = 0.2
    let top = 2.2
    let pos = (
      u1: (0, top), u2: (1.5, top), v1: (3, top), v2: (4.5, top),
      w1: (6, top), w2: (7.5, top), q0: (9, top),
      cur: (0.75, 0), clone: (3.75, 0), x1: (6, 0), x2: (7.5, 0),
    )
    let names = (
      u1: $u_1 = "last"$, u2: $u_l$, v1: $v_1 = p$, v2: $v_k$,
      w1: $w_1$, w2: $w_2$, q0: $q_0$,
      cur: $"cur"$, clone: $"clone"$, x1: $slink(q)$, x2: [],
    )
    let clip(p, q) = {
      let (dx, dy) = (q.at(0) - p.at(0), q.at(1) - p.at(1))
      let d = calc.sqrt(dx * dx + dy * dy)
      (p.at(0) + r * dx / d, p.at(1) + r * dy / d)
    }
    let arrow(a, b, stroke, fill) = {
      let (pa, pb) = (pos.at(a), pos.at(b))
      line(clip(pa, pb), clip(pb, pa), stroke: stroke, mark: (end: ">", scale: 0.5, fill: fill))
    }
    let old-link = (paint: muted, thickness: 0.7pt, dash: "dashed")
    let new-link = (paint: accent, thickness: 0.7pt, dash: "dashed")

    for (name, p) in pos {
      circle(p, radius: r, stroke: 0.7pt + ink, fill: if name in ("cur", "clone") { hl } else { none })
      let dy = if p.at(1) == top { r + 0.3 } else { -r - 0.3 }
      content((p.at(0), p.at(1) + dy), text(size: 8pt)[#names.at(name)])
    }

    // Старый путь: ссылки слева направо.
    for (a, b) in (("u1", "u2"), ("u2", "v1"), ("v1", "v2"), ("v2", "w1"), ("w1", "w2"), ("w2", "q0")) {
      arrow(a, b, old-link, muted)
    }
    // Новый путь: cur -> clone -> link(q) -> ... -> q0.
    for (a, b) in (("cur", "clone"), ("clone", "x1"), ("x1", "x2"), ("x2", "q0")) {
      arrow(a, b, new-link, accent)
    }
    // Рёбра по c.
    for (a, b) in (("u1", "cur"), ("u2", "cur"), ("v1", "clone"), ("v2", "clone"), ("w1", "x1"), ("w2", "x2")) {
      arrow(a, b, 0.7pt + ink, ink)
    }

    // Подписи групп над старым путём.
    let group(x0, x1, body) = {
      let y = top + 0.95
      line((x0 - 0.3, y - 0.12), (x0 - 0.3, y), (x1 + 0.3, y), (x1 + 0.3, y - 0.12), stroke: 0.5pt + muted)
      content(((x0 + x1) / 2, y + 0.3), text(size: 7.5pt, fill: muted)[#body])
    }
    group(0, 1.5, [$l$ шт.: в cur])
    group(3, 4.5, [$k$ шт.: в clone])
    group(6, 9, [$r$ шт.: остаток])
  })
]

